# FRONTEND (Flask UI)

# CrewAI AMP deployment the UI talks to
DEPLOYMENT_URL=
DEPLOYMENT_KEY=

# Shared secret — MUST match WEBHOOK_TOKEN in the backend .env.
# Used here to validate incoming webhook events.
WEBHOOK_TOKEN=

# Shared password for the UI. Leave blank to run without a login (fine locally).
# REQUIRED before exposing the app — without it, anyone with the URL can spend
# your API budget.
APP_PASSWORD=

# Signs the session cookie. Optional: derived from APP_PASSWORD when blank, which
# keeps people logged in across restarts. Set explicitly to rotate sessions.
SECRET_KEY=

# Spend guards. Per-session sliding window plus a process-wide daily cap.
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW=600
DAILY_MESSAGE_CAP=500

# Public URL AMP calls back for webhook events (used in dev AND prod).
# In prod it falls back to the request URL, but setting it explicitly is recommended.
PUBLIC_BASE_URL=https://crewai-chatbot.ngrok.app

# DEV ONLY — in production Heroku injects PORT and NGROK_DOMAIN is unused.
NGROK_DOMAIN=crewai-chatbot.ngrok.app
PORT=5005
