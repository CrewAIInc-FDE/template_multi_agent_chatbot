ARIZE_API_KEY=
ARIZE_PROJECT_NAME=
ARIZE_SPACE_ID=

GEMINI_API_KEY=
SERPER_API_KEY=

MONGODB_CONNECTION_STRING=
MONGODB_DATABASE_NAME=
MONGODB_COLLECTION_NAME=

DEPLOYMENT_URL=
DEPLOYMENT_KEY=

# Shared secret AMP uses to authenticate its realtime webhook calls back to us
# (sent as the bearer token in the kickoff "webhooks.authentication" block)
WEBHOOK_TOKEN=my-secret-token

# Public base URL that AMP can reach to deliver webhooks (the ngrok tunnel).
# Webhook events are POSTed to {PUBLIC_BASE_URL}/api/webhook/<channel_id>.
# If unset, derived automatically from the incoming request.
PUBLIC_BASE_URL=https://crewai-chatbot.ngrok.app

# ngrok reserved domain used by bin/start
NGROK_DOMAIN=crewai-chatbot.ngrok.app

# DEV
PORT=5005
CREWAI_TRACING_ENABLED=true
