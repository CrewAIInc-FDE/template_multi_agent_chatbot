# BACKEND (CrewAI flow / crews — deployed to AMP)

## Evals
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=
ARIZE_SPACE_ID=

## Agents
GEMINI_API_KEY=

## RAG / embeddings
OPENAI_API_KEY=
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE_NAME=
MONGODB_COLLECTION_NAME=

## Web search
SERPER_API_KEY=

## Shared secret — MUST match WEBHOOK_TOKEN in frontend/.env.
## Used here to sign outgoing webhook events.
WEBHOOK_TOKEN=

# DEV
CREWAI_TRACING_ENABLED=true

## Slack agent (CrewAI Platform integration)
## Connect Slack in the AMP dashboard, then copy the token from Integration Settings.
CREWAI_PLATFORM_INTEGRATION_TOKEN=

## Slack is read-only by default. Set to true to let the agent post messages and
## DMs into the live workspace as the shared org account.
SLACK_ALLOW_WRITES=false
